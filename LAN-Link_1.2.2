VERSION = "V1.2.2"
DISCOVERY_PORT = 54545
PORT_POOL_START = 5000
PORT_POOL_MAX_INITIAL = 5500
_dynamic_port_ceiling = PORT_POOL_MAX_INITIAL


def get_lan_ip():
    """Returns the primary LAN IP address of the local machine."""
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except Exception:
        return "127.0.0.1"


def get_next_available_port():
    """Dynamically yields ports, expanding the pool ceiling if all current ones are busy."""
    global _dynamic_port_ceiling
    while True:
        for p in range(PORT_POOL_START, _dynamic_port_ceiling + 1):
            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            try:
                sock.bind(("0.0.0.0", p))
                return sock, p
            except OSError:
                sock.close()
                continue
        _dynamic_port_ceiling += 1
        print(f"[Server] Pool exhausted! Dynamically expanding port ceiling to {_dynamic_port_ceiling}...")


def discover_rooms(timeout=1.5):
    """Broadcasts a discovery packet on the LAN and collects room replies."""
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
    sock.settimeout(0.3)

    try:
        sock.sendto(b"CHATROOM_DISCOVER_V1", ("<broadcast>", DISCOVERY_PORT))
    except OSError:
        sock.close()
        return []

    results = {}
    end_time = time.time() + timeout
    while time.time() < end_time:
        try:
            data, addr = sock.recvfrom(1024)
        except socket.timeout:
            continue
        except OSError:
            break
        try:
            info = json.loads(data.decode("utf-8"))
        except (ValueError, UnicodeDecodeError):
            continue
        room = info.get("room")
        port = info.get("port")
        if not room or not port:
            continue
        
        key = (addr[0], port)
        results[key] = {
            "host": addr[0],
            "port": port,
            "room": room,
            "version": info.get("version", "Unknown"),
            "has_password": bool(info.get("has_password", False)),
            "is_verified": bool(info.get("is_verified", False)),
            "join_muted": bool(info.get("join_muted", False)),
            "domain_restriction": info.get("domain_restriction", "")
        }
    sock.close()
    return list(results.values())


def send_verification_email(sender_email, app_password, recipient_email, code, subject_prefix="LAN-Link"):
    """Helper function to send a 2FA verification email using Gmail SMTP."""
    msg = EmailMessage()
    msg["Subject"] = f"{subject_prefix} Verification Code"
    msg["From"] = sender_email
    msg["To"] = recipient_email
    msg.set_content(
        f"Your LAN-Link 2-Step verification code is:\n\n{code}\n\n"
        "This code expires shortly. Do not share it with anyone."
    )

    with smtplib.SMTP_SSL("smtp.gmail.com", 465) as smtp:
        smtp.login(sender_email, app_password)
        smtp.send_message(msg)


class RoomServer:
    """Pure networking: owns TCP room socket, discovery responder, file registry, and admin management."""

    def __init__(self, room_name, password, is_verified=False, domain_restriction="", smtp_sender="", smtp_password=""):
        self.room_name = room_name
        self.password = password
        self.is_verified = is_verified
        self.domain_restriction = domain_restriction.strip().lower()
        self.smtp_sender = smtp_sender.strip()
        self.smtp_password = smtp_password.strip()
        
        self.socket = None
        self.discovery_socket = None
        self.port = None
        self.clients = {}          # socket -> {"username": str, "email": str, "ip": str, "is_host": bool, "is_op": bool, "is_muted": bool}
        self.host_socket = None
        self.is_locked = False
        self.join_muted = False    # Auto-mute newly joined users
        self.banned_records = []   # list of {"username": lower str, "ip": str, "email": lower str or ""}

        # File sharing registry
        self.shared_files = {}     # file_id (int) -> {"owner_sock": sock, "owner_name": str, "owner_ip": str, "file_port": int, "filename": str, "filesize": int}
        self.next_file_id = 1
        
        self.lock = threading.RLock()
        self.running = False

    def start(self):
        sock, port = get_next_available_port()
        if sock is None or port is None:
            return None

        try:
            sock.listen()
            self.socket = sock
            self.port = port
        except OSError:
            sock.close()
            return None

        self.running = True
        threading.Thread(target=self._accept_loop, daemon=True).start()
        threading.Thread(target=self._discovery_responder, daemon=True).start()
        return self.port

    def stop(self):
        self.running = False
        with self.lock:
            for sock in list(self.clients.keys()):
                try:
                    sock.close()
                except OSError:
                    pass
            self.clients.clear()
        if self.socket:
            try:
                self.socket.close()
            except OSError:
                pass
            self.socket = None

    def _discovery_responder(self):
        udp_sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        udp_sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            udp_sock.bind(("0.0.0.0", DISCOVERY_PORT))
        except OSError:
            return
        self.discovery_socket = udp_sock
        udp_sock.settimeout(1.0)

        while self.running:
            try:
                data, addr = udp_sock.recvfrom(1024)
            except socket.timeout:
                continue
            except OSError:
                break
            if data == b"CHATROOM_DISCOVER_V1":
                reply = json.dumps({
                    "room": self.room_name,
                    "port": self.port,
                    "version": VERSION,
                    "has_password": bool(self.password),
                    "is_verified": self.is_verified,
                    "join_muted": self.join_muted,
                    "domain_restriction": self.domain_restriction
                }).encode("utf-8")
                try:
                    udp_sock.sendto(reply, addr)
                except OSError:
                    pass
        udp_sock.close()

    def _accept_loop(self):
        while self.running:
            try:
                sock, addr = self.socket.accept()
            except OSError:
                break
            threading.Thread(target=self._handle_client, args=(sock, addr), daemon=True).start()

    def _broadcast(self, message, exclude=None):
        with self.lock:
            dead = []
            for sock in self.clients:
                if sock is exclude:
                    continue
                try:
                    sock.sendall(message.encode("utf-8") if isinstance(message, str) else message)
                except OSError:
                    dead.append(sock)
            for sock in dead:
                self._cleanup_disconnected_client_locked(sock)

    def _cleanup_disconnected_client_locked(self, sock):
        self.clients.pop(sock, None)
        if self.host_socket == sock:
            self.host_socket = None
        to_remove = [fid for fid, info in self.shared_files.items() if info["owner_sock"] == sock]
        for fid in to_remove:
            removed = self.shared_files.pop(fid, None)
            if removed:
                _, ext = os.path.splitext(removed['filename'])
                ext_label = ext if ext else "no ext"
                self._broadcast(f"SYS_ALERT:** File '{removed['filename']}' (ID {fid} [{ext_label}]) removed because owner disconnected **\n")

    def _is_admin(self, sock):
        info = self.clients.get(sock, {})
        return info.get("is_host", False) or info.get("is_op", False)

    def _handle_client(self, sock, addr):
        client_ip = addr[0]
        if client_ip.startswith("::ffff:"):
            client_ip = client_ip[7:]

        if self.is_locked:
            sock.sendall(b"REJECT:Room is currently locked by the host.\n")
            sock.close()
            return

        if any(rec["ip"] == client_ip for rec in self.banned_records):
            sock.sendall(b"REJECT:You are banned from this room.\n")
            sock.close()
            return

        username = None
        user_email = "Guest (Unverified)"
        was_member = False
        try:
            # 1. Room Name Verification
            sock.sendall(b"ROOM_NAME:")
            submitted_room = sock.recv(1024).decode("utf-8").strip()
            if submitted_room != self.room_name:
                sock.sendall(b"REJECT:Wrong room name\n")
                return

            # 2. Strict Version Handshake Verification
            sock.sendall(b"ROOM_VERSION:")
            submitted_version = sock.recv(1024).decode("utf-8").strip()
            if submitted_version != VERSION:
                sock.sendall(f"REJECT:Version mismatch! Host is running {VERSION}, but you are running {submitted_version}.\n".encode("utf-8"))
                return

            # 3. Room Password Verification
            sock.sendall(b"ROOM_PASSWORD:")
            submitted_pw = sock.recv(1024).decode("utf-8").strip()
            if submitted_pw != self.password:
                sock.sendall(b"REJECT:Wrong password\n")
                return

            if self.is_verified:
                sock.sendall(b"NEED_EMAIL:")
                user_email = sock.recv(1024).decode("utf-8").strip().lower()

                if not user_email or user_email.startswith("guest"):
                    sock.sendall(b"REJECT:This server requires a verified email address.\n")
                    return
                
                if any(rec["email"] and rec["email"] == user_email for rec in self.banned_records):
                    sock.sendall(b"REJECT:Your email is banned from this room.\n")
                    return
                
                if self.domain_restriction:
                    if "@" in self.domain_restriction and not user_email.endswith(self.domain_restriction) and user_email != self.domain_restriction:
                        sock.sendall(f"REJECT:Email must match restriction '{self.domain_restriction}'\n".encode("utf-8"))
                        return

                code = f"{secrets.randbelow(1_000_000):06d}"
                try:
                    send_verification_email(self.smtp_sender, self.smtp_password, user_email, code, subject_prefix=self.room_name)
                except Exception as e:
                    sock.sendall(f"REJECT:Failed to send verification email ({e})\n".encode("utf-8"))
                    return

                sock.sendall(b"NEED_CODE:")
                submitted_code = sock.recv(1024).decode("utf-8").strip()
                if submitted_code != code:
                    sock.sendall(b"REJECT:Invalid 2FA verification code\n")
                    return
            else:
                sock.sendall(b"NEED_EMAIL:")
                recv_email = sock.recv(1024).decode("utf-8").strip()
                if recv_email:
                    user_email = recv_email

            sock.sendall(b"OK:Enter your username: ")
            username = sock.recv(1024).decode("utf-8").strip()
            if not username:
                username = f"user_{addr[1]}"

            if any(rec["username"] == username.lower() for rec in self.banned_records):
                sock.sendall(b"REJECT:Your username is banned from this room.\n")
                sock.close()
                return

            with self.lock:
                is_host_client = False
                if self.host_socket is None:
                    self.host_socket = sock
                    is_host_client = True

                existing_names = [c["username"] for c in self.clients.values()]
                if username in existing_names:
                    username = f"{username}_{addr[1]}"
                
                # Apply join_muted rule to non-host/non-op joiners
                should_mute = self.join_muted if not is_host_client else False

                self.clients[sock] = {
                    "username": username,
                    "email": user_email,
                    "ip": client_ip,
                    "is_host": is_host_client,
                    "is_op": is_host_client,
                    "is_muted": should_mute
                }
                was_member = True

            self._broadcast(f"SYS_JOIN:** {username} joined the room **\n", exclude=sock)
            
            help_msg = (
                f"Welcome to '{self.room_name}', {username}!\n"
                "Commands: /quit, /who, /realname, /msg <user> <msg>, /server <msg>, /share, /files, /download <id>, /clear, /ui 1|2|3"
            )
            if self._is_admin(sock):
                help_msg += ", /kick, /ban, /unban, /banlist, /mute, /unmute, /muteall, /unmuteall, /mutelist, /lock, /unlock, /password, /config, /advance, /announce, /op, /unop"
            sock.sendall((help_msg + "\n").encode("utf-8"))

            if should_mute:
                sock.sendall(b"SYS_ALERT:** You have been automatically muted upon joining this room. **\n")

            f_in = sock.makefile('r', encoding='utf-8', errors='ignore')
            for line in f_in:
                if not self.running:
                    break
                
                text = line.strip()
                if not text:
                    continue

                if self.clients[sock]["is_muted"] and not text.startswith(("/quit", "/who", "/realname", "/files", "/download", "/clear", "/server", "/msg")):
                    sock.sendall(b"Error: You are currently muted by an operator.\n")
                    continue

                if text.startswith("/clear") or text.startswith("/clearchat"):
                    with self.lock:
                        names = ", ".join([c["username"] for c in self.clients.values()])
                    cleared_help = (
                        f"Welcome to '{self.room_name}', {username}!\n"
                        "Commands: /quit, /who, /realname, /msg <user> <msg>, /server <msg>, /share, /files, /download <id>, /clear, /ui 1|2|3"
                    )
                    if self._is_admin(sock):
                        cleared_help += ", /kick, /ban, /unban, /banlist, /mute, /unmute, /muteall, /unmuteall, /mutelist, /lock, /unlock, /password, /config, /advance, /announce, /op, /unop"
                    sock.sendall(f"CLEAR_CHAT_TRIGGER\n{cleared_help}\nOnline: {names}\n".encode("utf-8"))
                    continue

                if text.startswith("__SHARE_REGISTER__:"):
                    parts = text.split(":", 3)
                    if len(parts) == 4:
                        filename = parts[1]
                        try:
                            filesize = int(parts[2])
                            file_port = int(parts[3])
                        except ValueError:
                            filesize = 0
                            file_port = 0
                        
                        owner_ip = client_ip
                        if owner_ip in ("127.0.0.1", "::1", "localhost"):
                            owner_ip = get_lan_ip()

                        _, ext = os.path.splitext(filename)
                        ext_label = ext if ext else "no ext"

                        with self.lock:
                            fid = self.next_file_id
                            self.next_file_id += 1
                            self.shared_files[fid] = {
                                "owner_sock": sock,
                                "owner_name": username,
                                "owner_ip": owner_ip,
                                "file_port": file_port,
                                "filename": filename,
                                "filesize": filesize
                            }
                        self._broadcast(f"SYS_ALERT:** [File Available] {username} shared '{filename}' (ID {fid} [{ext_label}], Size: {filesize} bytes). Type /download {fid} to get it. **\n", exclude=sock)
                        sock.sendall(f"FILE_REGISTERED:{fid}:{filename}\n".encode("utf-8"))
                    continue

                if text.startswith("/files"):
                    with self.lock:
                        if not self.shared_files:
                            sock.sendall(b"No files currently shared in this room.\n")
                        else:
                            file_list_str = "[Shared Files in Room]\n"
                            for fid, info in self.shared_files.items():
                                _, ext = os.path.splitext(info['filename'])
                                ext_label = ext if ext else "no ext"
                                file_list_str += f"  ID {fid} ({ext_label}): '{info['filename']}' (Shared by {info['owner_name']}, {info['filesize']} bytes)\n"
                            sock.sendall(file_list_str.encode("utf-8"))
                    continue

                if text.startswith("/download "):
                    parts = text.split(" ", 1)
                    if len(parts) == 2:
                        try:
                            fid = int(parts[1].strip())
                        except ValueError:
                            sock.sendall(b"Error: Invalid File ID.\n")
                            continue
                        
                        owner_ip = None
                        file_port = None
                        filename = ""
                        with self.lock:
                            if fid in self.shared_files:
                                owner_ip = self.shared_files[fid]["owner_ip"]
                                file_port = self.shared_files[fid]["file_port"]
                                filename = self.shared_files[fid]["filename"]

                        if not owner_ip or not file_port:
                            sock.sendall(b"Error: File not found or owner is offline.\n")
                        else:
                            sock.sendall(f"FILE_HOST_INFO:{fid}:{owner_ip}:{file_port}:{filename}\n".encode("utf-8"))
                    continue

                if text.startswith("/quit"):
                    break
                if text.startswith("/who"):
                    with self.lock:
                        names = ", ".join([f"{c['username']}{' (Host)' if c['is_host'] else (' (Op)' if c['is_op'] else '')}{' [Muted]' if c['is_muted'] else ''}" for c in self.clients.values()])
                    sock.sendall(f"Online: {names}\n".encode("utf-8"))
                    continue
                if text.startswith("/realname"):
                    with self.lock:
                        realnames = [f" - {c['username']}: {c['email']}" for c in self.clients.values()]
                    list_str = "\n".join(realnames)
                    sock.sendall(f"[Verified Email List]\n{list_str}\n".encode("utf-8"))
                    continue

                if text.startswith("/msg "):
                    parts = text.split(" ", 2)
                    if len(parts) < 3:
                        sock.sendall(b"Usage: /msg <username> <message>\n")
                        continue
                    
                    target_query = parts[1].strip().lower()
                    dm_msg = parts[2].strip()
                    if not dm_msg:
                        sock.sendall(b"Usage: /msg <username> <message>\n")
                        continue

                    target_sock = None
                    target_name = ""
                    with self.lock:
                        for s, info in self.clients.items():
                            if info["username"].lower() == target_query or info["username"].lower().startswith(target_query):
                                target_sock = s
                                target_name = info["username"]
                                break

                    if target_sock:
                        timestamp = time.strftime("%H:%M:%S")
                        try:
                            target_sock.sendall(f"[{timestamp}] [PRIVATE from {username}] {dm_msg}\n".encode("utf-8"))
                            if target_sock != sock:
                                sock.sendall(f"[{timestamp}] [PRIVATE to {target_name}] {dm_msg}\n".encode("utf-8"))
                        except OSError:
                            sock.sendall(b"Error: Failed to deliver private message.\n")
                    else:
                        sock.sendall(f"User '{target_query}' not found.\n".encode("utf-8"))
                    continue

                if text.startswith("/server "):
                    dm_msg = text[8:].strip()
                    if not dm_msg:
                        sock.sendall(b"Usage: /server <message to host>\n")
                        continue
                    
                    if not self.host_socket:
                        sock.sendall(b"Error: Host is not currently online in the room.\n")
                        continue

                    timestamp = time.strftime("%H:%M:%S")
                    try:
                        self.host_socket.sendall(f"[{timestamp}] [PRIVATE -> HOST from {username}] {dm_msg}\n".encode("utf-8"))
                        if sock != self.host_socket:
                            sock.sendall(f"[{timestamp}] [PRIVATE -> HOST to Host] {dm_msg}\n".encode("utf-8"))
                    except OSError:
                        sock.sendall(b"Error: Failed to deliver message to host.\n")
                    continue

                if text.startswith("/announce "):
                    if not self._is_admin(sock):
                        sock.sendall(b"Error: Operator privileges required for /announce.\n")
                        continue
                    announcement_text = text[10:].strip()
                    if not announcement_text:
                        sock.sendall(b"Usage: /announce <message>\n")
                        continue
                    timestamp = time.strftime("%H:%M:%S")
                    self._broadcast(f"[ANNOUNCEMENT] [{timestamp}] {username}: {announcement_text}\n")
                    continue

                if text.startswith("/muteall"):
                    if not self._is_admin(sock):
                        sock.sendall(b"Error: Operator privileges required for /muteall.\n")
                        continue
                    newly_muted = []
                    with self.lock:
                        for s, info in self.clients.items():
                            if not info["is_host"] and not info["is_op"] and not info["is_muted"]:
                                info["is_muted"] = True
                                newly_muted.append(s)
                    self._broadcast(f"SYS_ALERT:** All non-operator members have been muted by {username} **\n")
                    sock.sendall(f"Muted {len(newly_muted)} member(s).\n".encode("utf-8"))
                    continue

                if text.startswith("/unmuteall"):
                    if not self._is_admin(sock):
                        sock.sendall(b"Error: Operator privileges required for /unmuteall.\n")
                        continue
                    newly_unmuted = []
                    with self.lock:
                        for s, info in self.clients.items():
                            if info["is_muted"]:
                                info["is_muted"] = False
                                newly_unmuted.append(s)
                    self._broadcast(f"SYS_ALERT:** All members have been unmuted by {username} **\n")
                    sock.sendall(f"Unmuted {len(newly_unmuted)} member(s).\n".encode("utf-8"))
                    continue

                if text.startswith("/mutelist"):
                    if not self._is_admin(sock):
                        sock.sendall(b"Error: Operator privileges required for /mutelist.\n")
                        continue
                    with self.lock:
                        muted_names = [c["username"] for c in self.clients.values() if c["is_muted"]]
                    if not muted_names:
                        sock.sendall(b"No members are currently muted.\n")
                    else:
                        list_str = "\n".join(f"  - {name}" for name in muted_names)
                        sock.sendall(f"[Muted Members] ({len(muted_names)})\n{list_str}\n".encode("utf-8"))
                    continue

                if text.startswith("/mute "):
                    if not self._is_admin(sock):
                        sock.sendall(b"Error: Operator privileges required for /mute.\n")
                        continue
                    target_query = text[6:].strip().lower()
                    target_sock = None
                    target_name = ""
                    with self.lock:
                        for s, info in self.clients.items():
                            if info["username"].lower() == target_query or info["username"].lower().startswith(target_query):
                                target_sock = s
                                target_name = info["username"]
                                info["is_muted"] = True
                                break
                    if target_sock:
                        self._broadcast(f"SYS_ALERT:** {target_name} was muted by {username} **\n")
                        target_sock.sendall(b"SYS_ALERT:** You have been muted by an operator **\n")
                    else:
                        sock.sendall(f"User '{target_query}' not found.\n".encode("utf-8"))
                    continue

                if text.startswith("/unmute "):
                    if not self._is_admin(sock):
                        sock.sendall(b"Error: Operator privileges required for /unmute.\n")
                        continue
                    target_query = text[8:].strip().lower()
                    target_sock = None
                    target_name = ""
                    with self.lock:
                        for s, info in self.clients.items():
                            if info["username"].lower() == target_query or info["username"].lower().startswith(target_query):
                                target_sock = s
                                target_name = info["username"]
                                info["is_muted"] = False
                                break
                    if target_sock:
                        self._broadcast(f"SYS_ALERT:** {target_name} was unmuted by {username} **\n")
                        target_sock.sendall(b"SYS_ALERT:** You have been unmuted **\n")
                    else:
                        sock.sendall(f"User '{target_query}' not found.\n".encode("utf-8"))
                    continue

                if text.startswith("/op "):
                    if not self._is_admin(sock):
                        sock.sendall(b"Error: Operator privileges required for /op.\n")
                        continue
                    target_query = text[4:].strip().lower()
                    target_sock = None
                    target_name = ""
                    with self.lock:
                        for s, info in self.clients.items():
                            if info["username"].lower() == target_query or info["username"].lower().startswith(target_query):
                                target_sock = s
                                target_name = info["username"]
                                info["is_op"] = True
                                break
                    if target_sock:
                        self._broadcast(f"SYS_ALERT:** {target_name} was granted Operator status by {username} **\n")
                    else:
                        sock.sendall(f"User '{target_query}' not found.\n".encode("utf-8"))
                    continue

                if text.startswith("/unop "):
                    if not self._is_admin(sock):
                        sock.sendall(b"Error: Operator privileges required for /unop.\n")
                        continue
                    target_query = text[6:].strip().lower()
                    target_sock = None
                    target_name = ""
                    with self.lock:
                        for s, info in self.clients.items():
                            if info["username"].lower() == target_query or info["username"].lower().startswith(target_query):
                                if info["is_host"]:
                                    sock.sendall(b"Error: Cannot revoke operator privileges from the primary server host.\n")
                                    target_sock = None
                                    break
                                target_sock = s
                                target_name = info["username"]
                                info["is_op"] = False
                                break
                    if target_sock:
                        self._broadcast(f"SYS_ALERT:** {target_name} operator status was revoked by {username} **\n")
                    continue

                if text.startswith("/lock"):
                    if not self._is_admin(sock):
                        sock.sendall(b"Error: Operator privileges required for /lock.\n")
                        continue
                    self.is_locked = True
                    self._broadcast(f"SYS_ALERT:** Room has been LOCKED by {username}. New connections will be rejected. **\n")
                    continue

                if text.startswith("/unlock"):
                    if not self._is_admin(sock):
                        sock.sendall(b"Error: Operator privileges required for /unlock.\n")
                        continue
                    self.is_locked = False
                    self._broadcast(f"SYS_ALERT:** Room has been UNLOCKED by {username}. New connections are allowed. **\n")
                    continue

                if text.startswith("/password"):
                    if not self._is_admin(sock):
                        sock.sendall(b"Error: Operator privileges required for /password.\n")
                        continue
                    pw_str = self.password if self.password else "(No password set)"
                    sock.sendall(f"[Operator Info] Current Room Password: '{pw_str}'\n".encode("utf-8"))
                    continue

                if text.startswith("/config"):
                    if not self._is_admin(sock):
                        sock.sendall(b"Error: Operator privileges required for /config.\n")
                        continue
                    parts = text.split(" ", 2)
                    if len(parts) < 3:
                        sock.sendall(
                            b"[Config Usage]\n"
                            b"  /config name <new_name>\n"
                            b"  /config password <new_pw | none>\n"
                            b"  /config domain <domain | none>\n"
                            b"  /config verify <on | off>\n"
                            b"  /config join_muted <on | off>\n"
                        )
                        continue
                    key, val = parts[1].lower(), parts[2].strip()
                    if key == "name":
                        self.room_name = val
                        self._broadcast(f"SYS_ALERT:** {username} changed room name to '{val}' **\n")
                    elif key == "password":
                        self.password = "" if val.lower() == "none" else val
                        sock.sendall(f"[Operator Info] Password updated to: '{self.password}'\n".encode("utf-8"))
                    elif key == "domain":
                        self.domain_restriction = "" if val.lower() == "none" else val.lower()
                        sock.sendall(f"[Operator Info] Domain restriction updated to: '{self.domain_restriction}'\n".encode("utf-8"))
                    elif key == "verify":
                        if val.lower() in ("on", "true", "1"):
                            self.is_verified = True
                            self._broadcast("SYS_ALERT:** Room security mode changed: 2FA Verification Enabled **\n")
                        elif val.lower() in ("off", "false", "0"):
                            self.is_verified = False
                            self._broadcast("SYS_ALERT:** Room security mode changed: 2FA Verification Disabled **\n")
                        else:
                            sock.sendall(b"Error: Use '/config verify on' or '/config verify off'\n")
                    elif key == "join_muted":
                        if val.lower() in ("on", "true", "1"):
                            self.join_muted = True
                            self._broadcast("SYS_ALERT:** Room setting changed: New joiners will be automatically muted **\n")
                        elif val.lower() in ("off", "false", "0"):
                            self.join_muted = False
                            self._broadcast("SYS_ALERT:** Room setting changed: New joiners will NOT be automatically muted **\n")
                        else:
                            sock.sendall(b"Error: Use '/config join_muted on' or '/config join_muted off'\n")
                    else:
                        sock.sendall(b"Error: Unknown config key. Options: name, password, domain, verify, join_muted\n")
                    continue

                if text.startswith("/advance") or text.startswith("/advanced"):
                    if not self._is_admin(sock):
                        sock.sendall(b"Error: Operator privileges required for /advance.\n")
                        continue
                    with self.lock:
                        op_count = sum(1 for c in self.clients.values() if c["is_op"])
                        muted_count = sum(1 for c in self.clients.values() if c["is_muted"])
                        stats = (
                            f"[Advanced Server Statistics]\n"
                            f"  Room Name       : {self.room_name}\n"
                            f"  Script Version  : {VERSION}\n"
                            f"  LAN Address     : {get_lan_ip()}:{self.port}\n"
                            f"  Room Lock Status: {'LOCKED' if self.is_locked else 'UNLOCKED'}\n"
                            f"  Join Muted      : {'ENABLED' if self.join_muted else 'DISABLED'}\n"
                            f"  Online Clients  : {len(self.clients)} ({op_count} Operators)\n"
                            f"  Muted Clients   : {muted_count}\n"
                            f"  Shared Files    : {len(self.shared_files)}\n"
                            f"  Verified (2FA)  : {self.is_verified}\n"
                            f"  Domain Restr.   : {self.domain_restriction if self.domain_restriction else 'None'}\n"
                            f"  Banned Summary  : {len(self.banned_records)} entrie(s) (username+IP+email linked)\n"
                        )
                    sock.sendall(stats.encode("utf-8"))
                    continue

                if text.startswith("/kick "):
                    if not self._is_admin(sock):
                        sock.sendall(b"Error: Operator privileges required for /kick.\n")
                        continue
                    target_query = text[6:].strip().lower()
                    if not target_query:
                        sock.sendall(b"Usage: /kick <username>\n")
                        continue

                    target_sock = None
                    target_name = ""
                    with self.lock:
                        for s, info in self.clients.items():
                            if info["username"].lower() == target_query or info["username"].lower().startswith(target_query):
                                target_sock = s
                                target_name = info["username"]
                                break

                    if target_sock and target_sock != sock:
                        try:
                            target_sock.sendall(b"KICKED:You have been kicked from the room by an operator.\n")
                            target_sock.close()
                        except OSError:
                            pass
                        self._broadcast(f"SYS_ALERT:** {target_name} was kicked by {username} **\n")
                        sock.sendall(f"Successfully kicked {target_name}.\n".encode("utf-8"))
                    else:
                        sock.sendall(f"User '{target_query}' not found or cannot kick yourself.\n".encode("utf-8"))
                    continue

                if text.startswith("/ban "):
                    if not self._is_admin(sock):
                        sock.sendall(b"Error: Operator privileges required for /ban.\n")
                        continue
                    target_query = text[5:].strip().lower()
                    if not target_query:
                        sock.sendall(b"Usage: /ban <username or email>\n")
                        continue

                    target_sock = None
                    target_name = ""
                    with self.lock:
                        for s, info in self.clients.items():
                            if info["username"].lower() == target_query or info["email"].lower() == target_query or info["username"].lower().startswith(target_query):
                                target_sock = s
                                target_name = info["username"]
                                self.banned_records.append({
                                    "username": info["username"].lower(),
                                    "ip": info["ip"],
                                    "email": info["email"].lower() if info["email"] else ""
                                })
                                break

                    if target_sock and target_sock != sock:
                        try:
                            target_sock.sendall(b"BANNED:You have been banned from the room by an operator.\n")
                            target_sock.close()
                        except OSError:
                            pass
                        self._broadcast(f"SYS_ALERT:** {target_name} was banned by {username} **\n")
                        sock.sendall(f"Successfully banned {target_name}.\n".encode("utf-8"))
                    else:
                        sock.sendall(f"User or email '{target_query}' not found or cannot ban yourself.\n".encode("utf-8"))
                    continue

                if text.startswith("/banlist"):
                    if not self._is_admin(sock):
                        sock.sendall(b"Error: Operator privileges required for /banlist.\n")
                        continue
                    with self.lock:
                        if not self.banned_records:
                            sock.sendall(b"No users are currently banned from this room.\n")
                        else:
                            ban_str = f"[Banned Records List] ({len(self.banned_records)})\n"
                            for idx, rec in enumerate(self.banned_records, 1):
                                u = rec["username"] if rec["username"] else "N/A"
                                e = rec["email"] if rec["email"] else "N/A"
                                ban_str += f"  {idx}. User: '{u}' | IP: '{rec['ip']}' | Email: '{e}'\n"
                            sock.sendall(ban_str.encode("utf-8"))
                    continue

                if text.startswith("/unban "):
                    if not self._is_admin(sock):
                        sock.sendall(b"Error: Operator privileges required for /unban.\n")
                        continue
                    target_query = text[7:].strip().lower()
                    if not target_query:
                        sock.sendall(b"Usage: /unban <username, email, or IP>\n")
                        continue

                    matched_record = None
                    with self.lock:
                        for rec in self.banned_records:
                            if rec["username"] == target_query or rec["username"].startswith(target_query):
                                matched_record = rec
                                break
                        if matched_record is None:
                            for rec in self.banned_records:
                                if rec["email"] and (rec["email"] == target_query or rec["email"].startswith(target_query)):
                                    matched_record = rec
                                    break
                        if matched_record is None:
                            for rec in self.banned_records:
                                if rec["ip"] == target_query:
                                    matched_record = rec
                                    break
                        if matched_record:
                            self.banned_records.remove(matched_record)

                    if matched_record:
                        label = matched_record["username"] if matched_record["username"] else target_query
                        self._broadcast(f"SYS_ALERT:** {label} was unbanned by {username} **\n")
                    else:
                        sock.sendall(f"'{target_query}' was not found in the ban list (usernames, emails, and IPs are all checked).\n".encode("utf-8"))
                    continue

                timestamp = time.strftime("%H:%M:%S")
                is_op = "1" if self._is_admin(sock) else "0"
                is_ver = "1" if ("@" in self.clients[sock]["email"]) else "0"
                self._broadcast(f"CHAT:{is_op}:{is_ver}:[{timestamp}] {username}: {text}\n")

        except (ConnectionResetError, ConnectionAbortedError, OSError):
            pass
        finally:
            with self.lock:
                self._cleanup_disconnected_client_locked(sock)
            try:
                sock.close()
            except OSError:
                pass
            if username and was_member:
                self._broadcast(f"SYS_LEAVE:** {username} left the room **\n")


class ChatApp:
    def __init__(self, root):
        self.root = root
        self.root.title("LAN-Link V1.2.2")
        self.root.geometry("580x690")
        self.root.minsize(480, 540)

        self.ui_mode = 1  # 1 = New Look (Default with colors), 2 = Old Look (Classic), 3 = Matrix
        self.sock = None
        self.connected = False
        self.is_host = False
        self.my_username = ""
        self.room_server = None
        self.event_queue = queue.Queue()
        
        self.user_email = ""
        self.is_user_verified = False

        # Direct P2P File Server Listener Setup
        self.my_shared_files = {}
        self.pending_share_filepath = None
        
        self.file_server_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        self.file_server_socket.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        self.file_server_socket.bind(("0.0.0.0", 0))

        self.file_server_port = self.file_server_socket.getsockname()[1]
        self.file_server_socket.listen()
        threading.Thread(target=self._file_server_accept_loop, daemon=True).start()

        self.all_discovered_rooms = []
        self.filtered_rooms = []
        self.displayed_rooms = []
        self.rooms_loaded_count = 0
        self.selected_room = None

        self._build_debug_window()

        footer_frame = ttk.Frame(self.root, padding=(10, 2))
        footer_frame.pack(side="bottom", fill="x")

        self.version_lbl = ttk.Label(footer_frame, text=f"LAN-Link {VERSION}", font=("", 9, "bold"), foreground="gray")
        self.version_lbl.pack(side="left")

        self.debug_btn = ttk.Button(footer_frame, text="🐞 Toggle Debug Console", command=self._toggle_debug)
        self.debug_btn.pack(side="right")

        self._build_home_frame()
        self._build_host_frame()
        self._build_search_frame()
        self._build_join_frame()
        self._build_chat_frame()
        self._show_home()

        self.root.after(100, self._drain_queue)
        self.root.protocol("WM_DELETE_WINDOW", self._on_close)

    def _file_server_accept_loop(self):
        while True:
            try:
                sock, addr = self.file_server_socket.accept()
                threading.Thread(target=self._handle_direct_upload, args=(sock,), daemon=True).start()
            except OSError:
                break

    def _handle_direct_upload(self, sock):
        try:
            sock.settimeout(5.0)
            req = sock.recv(1024).decode("utf-8").strip()
            sock.settimeout(None)

            if req.startswith("GET_FILE:"):
                fid = int(req.split(":", 1)[1])
                filepath = self.my_shared_files.get(fid)
                if filepath and os.path.exists(filepath):
                    with open(filepath, "rb") as f:
                        while True:
                            chunk = f.read(65536)
                            if not chunk:
                                break
                            sock.sendall(chunk)
        except Exception as e:
            print(f"[P2P Server] Error uploading file: {e}")
        finally:
            try:
                sock.close()
            except OSError:
                pass

    def _build_debug_window(self):
        self.debug_window = tk.Toplevel(self.root)
        self.debug_window.title("Debug Console")
        self.debug_window.geometry("550x400")
        self.debug_window.withdraw()
        self.debug_window.protocol("WM_DELETE_WINDOW", self.debug_window.withdraw)

        self.debug_text = scrolledtext.ScrolledText(self.debug_window, state="disabled", wrap="word", font=("Consolas", 9))
        self.debug_text.pack(fill="both", expand=True, padx=5, pady=5)
        
        class StdoutRedirector:
            def __init__(self, eq):
                self.eq = eq
            def write(self, msg):
                if msg:
                    self.eq.put(("debug", msg))
            def flush(self): pass
            
        sys.stdout = StdoutRedirector(self.event_queue)
        sys.stderr = sys.stdout

    def _toggle_debug(self):
        if self.debug_window.state() == "withdrawn":
            self.debug_window.deiconify()
        else:
            self.debug_window.withdraw()

