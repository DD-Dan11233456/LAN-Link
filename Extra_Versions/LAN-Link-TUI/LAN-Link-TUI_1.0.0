    def _build_tui_frame(self):
        """Builds in-app Console TUI screen."""
        self.tui_frame = ttk.Frame(self.root)

        header = ttk.Frame(self.tui_frame, padding=(10, 6))
        header.pack(fill="x")
        ttk.Label(header, text="[LAN-Link TUI 1.0.0.TUI]", font=("Consolas", 11, "bold")).pack(side="left")
        ttk.Button(header, text="Back to Main GUI", command=self._show_home).pack(side="right")

        body = ttk.Frame(self.tui_frame, padding=(10, 0, 10, 10))
        body.pack(fill="both", expand=True)

        self.tui_console = scrolledtext.ScrolledText(
            body, state="disabled", wrap="word",
            bg="#000000", fg="#00FF00", insertbackground="#00FF00", font=("Consolas", 10)
        )
        self.tui_console.pack(fill="both", expand=True)

        entry_frame = ttk.Frame(self.tui_frame, padding=(10, 0, 10, 10))
        entry_frame.pack(fill="x")
        
        ttk.Label(entry_frame, text=">", font=("Consolas", 11, "bold")).pack(side="left", padx=(0, 4))
        self.tui_entry = ttk.Entry(entry_frame, font=("Consolas", 10))
        self.tui_entry.pack(side="left", fill="x", expand=True)
        self.tui_entry.bind("<Return>", lambda e: self._process_app_tui_command())
        ttk.Button(entry_frame, text="Run Command", command=self._process_app_tui_command).pack(side="left", padx=(6, 0))

    def _show_tui(self):
        self._hide_all()
        self.tui_frame.pack(fill="both", expand=True)
        self.tui_entry.focus_set()
        
        if not hasattr(self, '_tui_welcome_printed'):
            self._tui_welcome_printed = True
            banner = (
                "[LAN-Link-TUI 1.0.0.TUI Mode Active]\n"
                "----------------------------------------\n"
                "Type 'zz' anywhere in Google Docs/Word to inject/close Doc TUI.\n"
                "Commands:\n"
                "  /search                         - LAN search (broadcast)\n"
                "  /ip_search <ip>                 - Search specific target IP\n"
                "  /join <id_or_ip> [pw] [username]- Join by search ID or IP\n"
                "  /host <room> [pw] [username]    - Host a room\n"
                "----------------------------------------\n\n"
            )
            self._append_app_tui_text(banner)

    def _append_app_tui_text(self, text):
        self.tui_console.configure(state="normal")
        self.tui_console.insert("end", text if text.endswith("\n") else text + "\n")
        self.tui_console.see("end")
        self.tui_console.configure(state="disabled")

    def _process_app_tui_command(self):
        cmd = self.tui_entry.get().strip()
        self.tui_entry.delete(0, "end")
        if not cmd: return

        self._append_app_tui_text(f"> {cmd}")
        cmd_parts = cmd.split()
        base_cmd = cmd_parts[0].lower()

        if not self.connected:
            if base_cmd == "/search":
                self._append_app_tui_text("[Searching network for rooms...]")
                threading.Thread(target=self._app_tui_search_bg, daemon=True).start()

            elif base_cmd == "/ip_search":
                if len(cmd_parts) < 2:
                    self._append_app_tui_text("Usage: /ip_search <target_ip>")
                    return
                target_ip = cmd_parts[1]
                self._append_app_tui_text(f"[Searching specific IP: {target_ip}...]")
                threading.Thread(target=self._app_tui_ip_search_bg, args=(target_ip,), daemon=True).start()

            elif base_cmd == "/join":
                params, err = self._resolve_join_parameters(cmd_parts)
                if err:
                    self._append_app_tui_text(err)
                    return
                host, port, room_name, password, username = params
                self._append_app_tui_text(f"Connecting to {host}:{port} ('{room_name}')...")
                self.join_room_tui(host, port, room_name, password, username)

            elif base_cmd == "/host":
                if len(cmd_parts) >= 2:
                    self.host_room_tui(cmd_parts[1], cmd_parts[2] if len(cmd_parts) > 2 else "", cmd_parts[3] if len(cmd_parts) > 3 else "Host")

            elif base_cmd == "/clear":
                self.tui_console.configure(state="normal")
                self.tui_console.delete("1.0", "end")
                self.tui_console.configure(state="disabled")

            else:
                self._append_app_tui_text("Unknown command.")
        else:
            if base_cmd in ("/leave", "/quit"):
                self.leave_room()
                self._append_app_tui_text("[Left room]")
            else:
                try: self.sock.sendall((cmd + "\n").encode("utf-8"))
                except OSError: self._append_app_tui_text("[Error] Connection lost.")

    def _app_tui_search_bg(self):
        rooms = discover_rooms()
        self._append_app_tui_text(self._format_room_search_results(rooms))

    def _app_tui_ip_search_bg(self, target_ip):
        rooms = discover_direct(target_ip)
        if rooms is None:
            self._append_app_tui_text("Error: Invalid IP address format.")
        else:
            self._append_app_tui_text(self._format_room_search_results(rooms))

    def _prompt_verify_email(self):
        use_txt = messagebox.askyesno("Verification Method", "Load credentials from a .txt file?")
        if use_txt:
            filepath = filedialog.askopenfilename(title="Select Config TXT", filetypes=[("Text Files", "*.txt")], parent=self.root)
            if not filepath: return
            try:
                with open(filepath, "r") as f:
                    lines = [l.strip() for l in f.readlines() if l.strip()]
                if len(lines) >= 3:
                    recipient_email, smtp_sender, smtp_password = lines[0].lower(), lines[1], lines[2]
                else:
                    messagebox.showerror("Error", "TXT file must contain at least 3 lines.")
                    return
            except Exception as e:
                messagebox.showerror("Error", f"Could not read file: {e}")
                return
        else:
            recipient_email = simpledialog.askstring("Account Verification", "Enter your email address:", parent=self.root)
            if not recipient_email or "@" not in recipient_email: return
            smtp_sender = simpledialog.askstring("SMTP Sender Email", "Enter sender Gmail address:", parent=self.root)
            if not smtp_sender: return
            smtp_password = simpledialog.askstring("SMTP App Password", "Enter 16-character Gmail App Password:", show="*", parent=self.root)
            if not smtp_password: return
            recipient_email = recipient_email.strip().lower()

        generated_code = f"{secrets.randbelow(1_000_000):06d}"
        try:
            send_verification_email(smtp_sender, smtp_password, recipient_email, generated_code)
            messagebox.showinfo("Email Sent", f"Code sent to {recipient_email}.")
        except Exception as e:
            messagebox.showerror("Failed", f"SMTP Error: {e}")
            return

        user_entered_code = simpledialog.askstring("Enter 2FA Code", f"Enter code sent to {recipient_email}:", parent=self.root)
        if user_entered_code and user_entered_code.strip() == generated_code:
            self.user_email = recipient_email
            self.is_user_verified = True
            self.account_status_var.set(f"Current Status: Verified ({self.user_email})")
            messagebox.showinfo("Success", "Verification Successful!")
        else:
            messagebox.showerror("Failed", "Incorrect 2FA code.")

    def _switch_to_guest(self):
        self.user_email = ""
        self.is_user_verified = False
        self.account_status_var.set("Current Status: Guest (Unverified)")

