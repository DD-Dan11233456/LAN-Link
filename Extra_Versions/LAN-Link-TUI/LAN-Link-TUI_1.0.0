    def _toggle_host_verified_options(self):
        if self.is_verified_var.get():
            self.domain_label.grid(); self.domain_entry.grid()
            self.smtp_email_label.grid(); self.smtp_email_entry.grid()
            self.smtp_pw_label.grid(); self.smtp_pw_entry.grid()
        else:
            self.domain_label.grid_remove(); self.domain_entry.grid_remove()
            self.smtp_email_label.grid_remove(); self.smtp_email_entry.grid_remove()
            self.smtp_pw_label.grid_remove(); self.smtp_pw_entry.grid_remove()

