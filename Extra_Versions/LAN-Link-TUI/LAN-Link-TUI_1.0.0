#!/usr/bin/env python3
"""
LAN-Link V1.0.0.TUI - Direct P2P File Share, Messaging & Doc TUI Edition
Author: Daniel Cave

Features:
 - Version tag set to 1.0.0.TUI across discovery and handshake handlers.
 - LAN-wide room search (/search) and target IP discovery (/ip_search <ip>).
 - Room indexing for fast joining via search ID (/join <id>) or IP (/join <ip>).
 - Marker-based Google Docs overlay system (‹‹LANLINK_TUI_START››).
 - Direct P2P file transfer, 2FA verification support, and multiple UI themes.
"""

import sys
import socket
import threading
import queue
import json
import time
import smtplib
import secrets
import os
import re
import webbrowser
import ipaddress
import subprocess
import platform
from email.message import EmailMessage
import tkinter as tk
from tkinter import ttk, scrolledtext, messagebox, simpledialog, filedialog

try:
    from pynput import keyboard as pynput_keyboard
    HAS_PYNPUT = True
except Exception:
    pynput_keyboard = None
    HAS_PYNPUT = False

VERSION = "1.0.0.TUI"
DISCOVERY_PORT = 54545
PORT_POOL_START = 5000
PORT_POOL_MAX_INITIAL = 5500
_dynamic_port_ceiling = PORT_POOL_MAX_INITIAL
START_MARKER = "‹‹LANLINK_TUI_START››"


def get_lan_ip():
    """Returns the primary LAN IP address of the local machine."""
    for target in ("8.8.8.8", "1.1.1.1"):
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            s.connect((target, 80))
            ip = s.getsockname()[0]
            s.close()
            if ip and not ip.startswith("127."):
                return ip
        except Exception:
            pass
    try:
        ip = socket.gethostbyname(socket.gethostname())
        if ip and not ip.startswith("127."):
            return ip
    except Exception:
        pass
    return "127.0.0.1"


def get_broadcast_targets():
    """Returns every broadcast address worth attempting."""
    targets = ["255.255.255.255"]
    try:
        out = subprocess.run(["ip", "-4", "-o", "addr", "show"], capture_output=True,
                             text=True, timeout=2).stdout
        for m in re.finditer(r"inet (\d+\.\d+\.\d+\.\d+)/\d+.*?brd (\d+\.\d+\.\d+\.\d+)", out):
            if not m.group(1).startswith("127."):
                targets.append(m.group(2))
    except Exception:
        pass
    lan = get_lan_ip()
    if not lan.startswith("127."):
        a, b, c, _ = lan.split(".")
        targets.append(f"{a}.{b}.{c}.255")
    seen, unique = set(), []
    for t in targets:
        if t not in seen:
            seen.add(t)
            unique.append(t)
    return unique


def get_next_available_port():
    """Dynamically binds ports, expanding ceiling if occupied."""
    global _dynamic_port_ceiling
    while True:
        for p in range(PORT_POOL_START, _dynamic_port_ceiling + 1):
            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            try:
                sock.bind(("0.0.0.0", p))
                return sock, p
            except OSError:
                sock.close()
                continue
        _dynamic_port_ceiling += 1


def discover_rooms(timeout=2.5):
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
    sock.settimeout(0.3)

    lan = get_lan_ip()
    if not lan.startswith("127."):
        try:
            sock.bind((lan, 0))
        except OSError:
            pass

    targets = get_broadcast_targets()

    def send_probe():
        sent = False
        for t in targets:
            try:
                sock.sendto(b"CHATROOM_DISCOVER_V1", (t, DISCOVERY_PORT))
                sent = True
            except OSError:
                continue
        return sent

    if not send_probe():
        sock.close()
        return []

    results = {}
    start_time = time.time()
    end_time = start_time + timeout
    resent = False
    while time.time() < end_time:
        if not resent and time.time() - start_time > timeout / 2:
            send_probe()
            resent = True
        try:
            data, addr = sock.recvfrom(1024)
        except socket.timeout:
            continue
        except OSError:
            break
        try:
            info = json.loads(data.decode("utf-8"))
        except (ValueError, UnicodeDecodeError):
            continue
        room = info.get("room")
        port = info.get("port")
        if not room or not port:
            continue
        
        key = (addr[0], port)
        results[key] = {
            "host": addr[0],
            "port": port,
            "room": room,
            "version": info.get("version", "Unknown"),
            "has_password": bool(info.get("has_password", False)),
            "is_verified": bool(info.get("is_verified", False)),
            "join_muted": bool(info.get("join_muted", False)),
            "domain_restriction": info.get("domain_restriction", "")
        }
    sock.close()
    return list(results.values())


def discover_direct(ip, timeout=2.0):
    try:
        ip = str(ipaddress.ip_address(ip.strip()))
    except ValueError:
        return None
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.settimeout(0.5)
    found = []
    try:
        end_time = time.time() + timeout
        sock.sendto(b"CHATROOM_DISCOVER_V1", (ip, DISCOVERY_PORT))
        while time.time() < end_time and not found:
            try:
                data, addr = sock.recvfrom(1024)
            except socket.timeout:
                continue
            try:
                info = json.loads(data.decode("utf-8"))
            except (ValueError, UnicodeDecodeError):
                continue
            if info.get("room") and info.get("port"):
                found.append({
                    "host": addr[0], "port": info["port"], "room": info["room"],
                    "version": info.get("version", "Unknown"),
                    "has_password": bool(info.get("has_password", False)),
                    "is_verified": bool(info.get("is_verified", False)),
                    "join_muted": bool(info.get("join_muted", False)),
                    "domain_restriction": info.get("domain_restriction", ""),
                })
    except OSError:
        pass
    finally:
        sock.close()
    return found


def send_verification_email(sender_email, app_password, recipient_email, code, subject_prefix="LAN-Link"):
    msg = EmailMessage()
    msg["Subject"] = f"{subject_prefix} Verification Code"
    msg["From"] = sender_email
    msg["To"] = recipient_email
    msg.set_content(
        f"Your LAN-Link 2-Step verification code is:\n\n{code}\n\n"
        "This code expires shortly. Do not share it with anyone."
    )

    with smtplib.SMTP_SSL("smtp.gmail.com", 465) as smtp:
        smtp.login(sender_email, app_password)
        smtp.send_message(msg)


class RoomServer:
    def __init__(self, room_name, password, is_verified=False, domain_restriction="", smtp_sender="", smtp_password=""):
        self.room_name = room_name
        self.password = password
        self.is_verified = is_verified
        self.domain_restriction = domain_restriction.strip().lower()
        self.smtp_sender = smtp_sender.strip()
        self.smtp_password = smtp_password.strip()
        
        self.socket = None
        self.discovery_socket = None
        self.port = None
        self.clients = {}         
        self.host_socket = None
        self.is_locked = False
        self.join_muted = False
        self.op_password = "no"
        self.banned_records = []   

        self.shared_files = {}     
        self.next_file_id = 1
        
        self.lock = threading.RLock()
        self.running = False

    def start(self):
        sock, port = get_next_available_port()
        if sock is None or port is None:
            return None

        try:
            sock.listen()
            self.socket = sock
            self.port = port
        except OSError:
            sock.close()
            return None

        self.running = True
        threading.Thread(target=self._accept_loop, daemon=True).start()
        threading.Thread(target=self._discovery_responder, daemon=True).start()
        return self.port

    def stop(self):
        self.running = False
        with self.lock:
            for sock in list(self.clients.keys()):
                try: sock.close()
                except OSError: pass
            self.clients.clear()
        if self.socket:
            try: self.socket.close()
            except OSError: pass
            self.socket = None

    def _discovery_responder(self):
        udp_sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        udp_sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            udp_sock.bind(("0.0.0.0", DISCOVERY_PORT))
        except OSError:
            return
        self.discovery_socket = udp_sock
        udp_sock.settimeout(1.0)

        while self.running:
            try:
                data, addr = udp_sock.recvfrom(1024)
            except socket.timeout:
                continue
            except OSError:
                break
            if data == b"CHATROOM_DISCOVER_V1":
                reply = json.dumps({
                    "room": self.room_name,
                    "port": self.port,
                    "version": VERSION,
                    "has_password": bool(self.password),
                    "is_verified": self.is_verified,
                    "join_muted": self.join_muted,
                    "domain_restriction": self.domain_restriction
                }).encode("utf-8")
                try:
                    udp_sock.sendto(reply, addr)
                except OSError:
                    pass
        udp_sock.close()

    def _accept_loop(self):
        while self.running:
            try:
                sock, addr = self.socket.accept()
            except OSError:
                break
            threading.Thread(target=self._handle_client, args=(sock, addr), daemon=True).start()

    def _broadcast(self, message, exclude=None):
        with self.lock:
            dead = []
            for sock in self.clients:
                if sock is exclude: continue
                try:
                    sock.sendall(message.encode("utf-8") if isinstance(message, str) else message)
                except OSError:
                    dead.append(sock)
            for sock in dead:
                self._cleanup_disconnected_client_locked(sock)

    def _cleanup_disconnected_client_locked(self, sock):
        self.clients.pop(sock, None)
        if self.host_socket == sock:
            self.host_socket = None
        to_remove = [fid for fid, info in self.shared_files.items() if info["owner_sock"] == sock]
        for fid in to_remove:
            removed = self.shared_files.pop(fid, None)
            if removed:
                _, ext = os.path.splitext(removed['filename'])
                ext_label = ext if ext else "no ext"
                self._broadcast(f"SYS_ALERT:** File '{removed['filename']}' (ID {fid} [{ext_label}]) removed because owner disconnected **\n")

    def _is_admin(self, sock):
        info = self.clients.get(sock, {})
        return info.get("is_host", False) or info.get("is_op", False)

    def _handle_client(self, sock, addr):
        client_ip = addr[0]
        if client_ip.startswith("::ffff:"):
            client_ip = client_ip[7:]

        if self.is_locked:
            sock.sendall(b"REJECT:Room is currently locked by the host.\n")
            sock.close()
            return

        if any(rec["ip"] == client_ip for rec in self.banned_records):
            sock.sendall(b"REJECT:You are banned from this room.\n")
            sock.close()
            return

        username = None
        user_email = "Guest (Unverified)"
        was_member = False
        try:
            sock.sendall(b"ROOM_NAME:")
            submitted_room = sock.recv(1024).decode("utf-8").strip()
            if submitted_room != self.room_name:
                sock.sendall(b"REJECT:Wrong room name\n")
                return

            sock.sendall(b"ROOM_VERSION:")
            submitted_version = sock.recv(1024).decode("utf-8").strip()
            if submitted_version != VERSION:
                sock.sendall(f"REJECT:Version mismatch! Host is running {VERSION}, but you are running {submitted_version}.\n".encode("utf-8"))
                return

            sock.sendall(b"ROOM_PASSWORD:")
            submitted_pw = sock.recv(1024).decode("utf-8").strip()
            if submitted_pw != self.password:
                sock.sendall(b"REJECT:Wrong password\n")
                return

            if self.is_verified:
                sock.sendall(b"NEED_EMAIL:")
                user_email = sock.recv(1024).decode("utf-8").strip().lower()

                if not user_email or user_email.startswith("guest"):
                    sock.sendall(b"REJECT:This server requires a verified email address.\n")
                    return
                
                if any(rec["email"] and rec["email"] == user_email for rec in self.banned_records):
                    sock.sendall(b"REJECT:Your email is banned from this room.\n")
                    return
                
                if self.domain_restriction:
                    if "@" in self.domain_restriction and not user_email.endswith(self.domain_restriction) and user_email != self.domain_restriction:
                        sock.sendall(f"REJECT:Email must match restriction '{self.domain_restriction}'\n".encode("utf-8"))
                        return

                code = f"{secrets.randbelow(1_000_000):06d}"
                try:
                    send_verification_email(self.smtp_sender, self.smtp_password, user_email, code, subject_prefix=self.room_name)
                except Exception as e:
                    sock.sendall(f"REJECT:Failed to send verification email ({e})\n".encode("utf-8"))
                    return

                sock.sendall(b"NEED_CODE:")
                submitted_code = sock.recv(1024).decode("utf-8").strip()
                if submitted_code != code:
                    sock.sendall(b"REJECT:Invalid 2FA verification code\n")
                    return
            else:
                sock.sendall(b"NEED_EMAIL:")
                recv_email = sock.recv(1024).decode("utf-8").strip()
                if recv_email:
                    user_email = recv_email

            sock.sendall(b"OK:Enter your username: ")
            username = sock.recv(1024).decode("utf-8").strip()
            if not username:
                username = f"user_{addr[1]}"

            if any(rec["username"] == username.lower() for rec in self.banned_records):
                sock.sendall(b"REJECT:Your username is banned from this room.\n")
                sock.close()
                return

            with self.lock:
                is_host_client = False
                if self.host_socket is None:
                    self.host_socket = sock
                    is_host_client = True

                existing_names = [c["username"] for c in self.clients.values()]
                if username in existing_names:
                    username = f"{username}_{addr[1]}"
                
                should_mute = self.join_muted if not is_host_client else False

                self.clients[sock] = {
                    "username": username,
                    "email": user_email,
                    "ip": client_ip,
                    "is_host": is_host_client,
                    "is_op": is_host_client,
                    "is_muted": should_mute,
                    "is_afk": False
                }
                was_member = True

            self._broadcast(f"SYS_JOIN:** {username} joined the room **\n", exclude=sock)
            
            help_msg = (
                f"Welcome to '{self.room_name}', {username}!\n"
                "Commands: /quit, /who, /realname, /ip, /msg <user> <msg>, /server <msg>, /share, /files, /download <id>, /clear, /ui 1|2|3|4, /afk"
            )
            sock.sendall((help_msg + "\n").encode("utf-8"))

            f_in = sock.makefile('r', encoding='utf-8', errors='ignore')
            for line in f_in:
                if not self.running: break
                text = line.strip()
                if not text: continue
                if text == "/quit": break
                
                timestamp = time.strftime("%H:%M:%S")
                is_op = "1" if self._is_admin(sock) else "0"
                is_ver = "1" if ("@" in self.clients[sock]["email"]) else "0"
                self._broadcast(f"CHAT:{is_op}:{is_ver}:[{timestamp}] {username}: {text}\n")

        except (ConnectionResetError, ConnectionAbortedError, OSError):
            pass
        finally:
            with self.lock:
                self._cleanup_disconnected_client_locked(sock)
            try: sock.close()
            except OSError: pass
            if username and was_member:
                self._broadcast(f"SYS_LEAVE:** {username} left the room **\n")


class ChatApp:
    _last_global_key_time = 0

    def __init__(self, root):
        self.root = root
        self.root.title(f"LAN-Link {VERSION}")
        self.root.geometry("580x690")
        self.root.minsize(480, 540)

        self.ui_mode = 1
        self.sock = None
        self.connected = False
        self.is_host = False
        self.my_username = ""
        self.room_server = None
        self.event_queue = queue.Queue()
        
        self.user_email = ""
        self.is_user_verified = False

        self.chat_history = []
        self.last_sent_msg = ""
        self.eject_level = 0
        self.eject_key = 'alt'
        self.last_key_time = 0
        self._tk_key_down = False
        self._global_key_down = False
        self._last_eject_time = 0
        self.global_listener = None

        # Doc TUI & Search Cache Engine
        self.doc_tui_active = False
        self.doc_cmd_buffer = ""
        self.last_z_time = 0
        self.z_tap_count = 0
        self._is_injecting_keys = False
        self.last_discovered_rooms = []
        self.pynput_ctrl = pynput_keyboard.Controller() if HAS_PYNPUT else None

        self._start_global_doc_and_eject_listener()

        self.my_shared_files = {}
        self.pending_share_filepath = None
        
        self.file_server_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        self.file_server_socket.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        self.file_server_socket.bind(("0.0.0.0", 0))
        self.file_server_port = self.file_server_socket.getsockname()[1]
        self.file_server_socket.listen()
        threading.Thread(target=self._file_server_accept_loop, daemon=True).start()

        self.all_discovered_rooms = []
        self.filtered_rooms = []
        self.displayed_rooms = []
        self.rooms_loaded_count = 0
        self.selected_room = None

        self._build_debug_window()

        footer_frame = ttk.Frame(self.root, padding=(10, 2))
        footer_frame.pack(side="bottom", fill="x")

        self.version_lbl = ttk.Label(footer_frame, text=f"LAN-Link {VERSION}", font=("", 9, "bold"), foreground="gray")
        self.version_lbl.pack(side="left")
        self.debug_btn = ttk.Button(footer_frame, text="🐞 Toggle Debug Console", command=self._toggle_debug)
        self.debug_btn.pack(side="right")

        self._build_home_frame()
        self._build_host_frame()
        self._build_search_frame()
        self._build_join_frame()
        self._build_chat_frame()
        self._build_tui_frame()
        self._show_home()

        self.root.after(100, self._drain_queue)
        self.root.protocol("WM_DELETE_WINDOW", self._on_close)

    def _start_global_doc_and_eject_listener(self):
        if not HAS_PYNPUT:
            return

        def on_press(key):
            if self._is_injecting_keys:
                return

            try:
                now = time.time()
                char = getattr(key, 'char', None)

                # System-wide double tap 'zz' trigger
                if char and char.lower() == 'z':
                    diff = now - self.last_z_time
                    if diff > 0.08:
                        if diff < 0.5:
                            self.z_tap_count += 1
                        else:
                            self.z_tap_count = 1
                        self.last_z_time = now

                        if self.z_tap_count >= 2:
                            self.z_tap_count = 0
                            threading.Thread(target=self._toggle_doc_tui_overlay, daemon=True).start()
                            return

                if self.doc_tui_active:
                    if key == pynput_keyboard.Key.enter:
                        cmd = self.doc_cmd_buffer.strip()
                        self.doc_cmd_buffer = ""
                        if cmd:
                            threading.Thread(target=self._process_doc_tui_command, args=(cmd,), daemon=True).start()

                    elif key == pynput_keyboard.Key.backspace:
                        if len(self.doc_cmd_buffer) > 0:
                            self.doc_cmd_buffer = self.doc_cmd_buffer[:-1]

                    elif char:
                        self.doc_cmd_buffer += char

                    elif key == pynput_keyboard.Key.space:
                        self.doc_cmd_buffer += " "
            except Exception:
                pass

        try:
            self.global_listener = pynput_keyboard.Listener(on_press=on_press)
            self.global_listener.daemon = True
            self.global_listener.start()
        except Exception:
            pass

    def _paste_to_active_doc(self, text):
        self._is_injecting_keys = True
        try:
            self.root.clipboard_clear()
            self.root.clipboard_append(text if text.endswith("\n") else text + "\n")
            self.root.update()
            time.sleep(0.08)
            mod = pynput_keyboard.Key.cmd if platform.system() == "Darwin" else pynput_keyboard.Key.ctrl
            with self.pynput_ctrl.pressed(mod):
                self.pynput_ctrl.tap('v')
            time.sleep(0.08)
        except Exception:
            pass
        finally:
            self._is_injecting_keys = False

    def _erase_zz_in_doc(self):
        self._is_injecting_keys = True
        try:
            self.pynput_ctrl.tap(pynput_keyboard.Key.backspace)
            time.sleep(0.03)
            self.pynput_ctrl.tap(pynput_keyboard.Key.backspace)
            time.sleep(0.03)
        except Exception:
            pass
        finally:
            self._is_injecting_keys = False

    def _toggle_doc_tui_overlay(self):
        self._erase_zz_in_doc()

        if not self.doc_tui_active:
            self.doc_tui_active = True
            self.doc_cmd_buffer = ""
            header = (
                f"{START_MARKER}\n"
                "[LAN-Link-TUI 1.0.0.TUI]\n"
                "[Made by Daniel Cave]\n"
                "----------------------------------------\n"
                "Status: Active | Mode: Doc-TUI\n"
                "Commands: /search, /ip_search <ip>, /join <id_or_ip>, /host, /help\n"
                "----------------------------------------\n"
            )
            self._paste_to_active_doc(header)
        else:
            self.doc_tui_active = False
            self.doc_cmd_buffer = ""
            self._clear_doc_by_marker()

    def _clear_doc_by_marker(self):
        self._is_injecting_keys = True
        try:
            mod = pynput_keyboard.Key.cmd if platform.system() == "Darwin" else pynput_keyboard.Key.ctrl
            
            with self.pynput_ctrl.pressed(mod):
                self.pynput_ctrl.tap('a')
            time.sleep(0.15)

            with self.pynput_ctrl.pressed(mod):
                self.pynput_ctrl.tap('c')
            time.sleep(0.15)

            doc_text = self.root.clipboard_get()
            if START_MARKER in doc_text:
                clean_text = doc_text.split(START_MARKER)[0]
                self.root.clipboard_clear()
                self.root.clipboard_append(clean_text)
                self.root.update()
                time.sleep(0.08)
                with self.pynput_ctrl.pressed(mod):
                    self.pynput_ctrl.tap('v')
                time.sleep(0.08)
        except Exception:
            pass
        finally:
            self._is_injecting_keys = False

    def _format_room_search_results(self, rooms):
        self.last_discovered_rooms = rooms
        if not rooms:
            return "No rooms found."
        
        out = f"[Discovered Rooms ({len(rooms)})]\n"
        for idx, r in enumerate(rooms, 1):
            pw_str = "🔒 Password" if r["has_password"] else "🔓 Open"
            out += f"  [{idx}] IP: {r['host']}:{r['port']} | Room: '{r['room']}' | {pw_str}\n"
        out += "To join, type: /join <id_or_ip> [password] [username]"
        return out

    def _resolve_join_parameters(self, cmd_parts):
        """Resolves flexible /join parameters by ID, IP, or full positional parameters."""
        if len(cmd_parts) < 2:
            return None, "Usage: /join <id_or_ip> [password] [username] OR /join <ip> <port> <room> [password] [username]"

        target_arg = cmd_parts[1].strip()
        
        # Scenario A: Joined by numeric ID (e.g. /join 1 mypass myuser)
        if target_arg.isdigit():
            idx = int(target_arg) - 1
            if 0 <= idx < len(self.last_discovered_rooms):
                room_info = self.last_discovered_rooms[idx]
                host = room_info["host"]
                port = room_info["port"]
                room_name = room_info["room"]
                password = cmd_parts[2] if len(cmd_parts) > 2 else ""
                username = cmd_parts[3] if len(cmd_parts) > 3 else (self.my_username or "User")
                return (host, port, room_name, password, username), None
            else:
                return None, f"Error: Room ID '{target_arg}' not found in recent search results. Run /search first."

        # Scenario B: Joined by IP alone (e.g. /join 192.168.1.50 mypass myuser)
        cached_room = next((r for r in self.last_discovered_rooms if r["host"] == target_arg), None)
        if cached_room:
            host = cached_room["host"]
            port = cached_room["port"]
            room_name = cached_room["room"]
            password = cmd_parts[2] if len(cmd_parts) > 2 else ""
            username = cmd_parts[3] if len(cmd_parts) > 3 else (self.my_username or "User")
            return (host, port, room_name, password, username), None

        # Scenario C: Full Positional Parameters (/join <ip> <port> <room_name> [password] [username])
        if len(cmd_parts) >= 4 and cmd_parts[2].isdigit():
            host = cmd_parts[1]
            port = int(cmd_parts[2])
            room_name = cmd_parts[3]
            password = cmd_parts[4] if len(cmd_parts) > 4 else ""
            username = cmd_parts[5] if len(cmd_parts) > 5 else (self.my_username or "User")
            return (host, port, room_name, password, username), None

        return None, f"Error: IP '{target_arg}' not in search cache. Use: /join <ip> <port> <room_name> [password] [username]"

    def _process_doc_tui_command(self, cmd):
        time.sleep(0.05)
        cmd_parts = cmd.split()
        if not cmd_parts: return

        base_cmd = cmd_parts[0].lower()

        if not self.connected:
            if base_cmd == "/search":
                self._paste_to_active_doc("\n[Broadcasting LAN room search...]")
                rooms = discover_rooms()
                self._paste_to_active_doc(self._format_room_search_results(rooms))

            elif base_cmd == "/ip_search":
                if len(cmd_parts) < 2:
                    self._paste_to_active_doc("Usage: /ip_search <target_ip>")
                    return
                target_ip = cmd_parts[1]
                self._paste_to_active_doc(f"\n[Searching specific IP: {target_ip}...]")
                rooms = discover_direct(target_ip)
                if rooms is None:
                    self._paste_to_active_doc("Error: Invalid IP address format.")
                else:
                    self._paste_to_active_doc(self._format_room_search_results(rooms))

            elif base_cmd == "/join":
                params, err = self._resolve_join_parameters(cmd_parts)
                if err:
                    self._paste_to_active_doc(err)
                    return
                host, port, room_name, password, username = params
                self._paste_to_active_doc(f"Connecting to {host}:{port} ('{room_name}')...")
                self.join_room_tui(host, port, room_name, password, username)

            elif base_cmd == "/host":
                if len(cmd_parts) < 2:
                    self._paste_to_active_doc("Usage: /host <room_name> [password] [username]")
                    return
                room = cmd_parts[1]
                pw = cmd_parts[2] if len(cmd_parts) > 2 else ""
                uname = cmd_parts[3] if len(cmd_parts) > 3 else "Host"
                self.host_room_tui(room, pw, uname)

            elif base_cmd == "/help":
                help_str = (
                    "\n[Available Commands]\n"
                    "  /search                         - Search active rooms on LAN\n"
                    "  /ip_search <ip>                 - Search a specific IP directly\n"
                    "  /join <id_or_ip> [pw] [username]- Join room by assigned search ID or IP\n"
                    "  /host <room_name> [pw] [user]   - Host a new room\n"
                    "  /quit                           - Exit LAN-Link\n"
                )
                self._paste_to_active_doc(help_str)
            else:
                self._paste_to_active_doc("\nUnknown command. Type /help")
        else:
            if base_cmd in ("/leave", "/quit"):
                self.leave_room()
                self._paste_to_active_doc("\n[Left room]")
            else:
                try:
                    self.sock.sendall((cmd + "\n").encode("utf-8"))
                except OSError:
                    self._paste_to_active_doc("\n[Error] Connection lost.")
                    self.connected = False

    def host_room_tui(self, room_name, password, username):
        server = RoomServer(room_name, password)
        port = server.start()
        self.room_server = server
        self.is_host = True
        self.join_room_tui("127.0.0.1", port, room_name, password, username)

    def join_room_tui(self, host, port, room, password, username):
        try:
            sock = socket.create_connection((host, port), timeout=5)
            sock.recv(1024)
            sock.sendall((room + "\n").encode("utf-8"))
            sock.recv(1024)
            sock.sendall((VERSION + "\n").encode("utf-8"))
            sock.recv(1024)
            sock.sendall((password + "\n").encode("utf-8"))
            sock.recv(1024)
            sock.sendall(b"Guest\n")
            sock.recv(1024)
            sock.sendall((username + "\n").encode("utf-8"))

            welcome = sock.recv(1024).decode("utf-8")
            self.sock = sock
            self.connected = True
            self.my_username = username
            self._paste_to_active_doc(f"\n[Connected to '{room}']\n{welcome.strip()}")
            threading.Thread(target=self._receive_loop_doc_tui, daemon=True).start()
        except Exception as e:
            self._paste_to_active_doc(f"\n[Connection Failed]: {e}")

    def _receive_loop_doc_tui(self):
        try:
            f_in = self.sock.makefile('r', encoding='utf-8', errors='ignore')
            for line in f_in:
                if not self.connected: break
                text = line.strip()
                if text and self.doc_tui_active:
                    self._paste_to_active_doc(text)
        except OSError:
            pass

    def _file_server_accept_loop(self):
        while True:
            try:
                sock, addr = self.file_server_socket.accept()
                threading.Thread(target=self._handle_direct_upload, args=(sock,), daemon=True).start()
            except OSError:
                break

    def _handle_direct_upload(self, sock):
        try:
            sock.settimeout(5.0)
            req = sock.recv(1024).decode("utf-8").strip()
            sock.settimeout(None)

            if req.startswith("GET_FILE:"):
                fid = int(req.split(":", 1)[1])
                filepath = self.my_shared_files.get(fid)
                if filepath and os.path.exists(filepath):
                    with open(filepath, "rb") as f:
                        while True:
                            chunk = f.read(65536)
                            if not chunk: break
                            sock.sendall(chunk)
        except Exception:
            pass
        finally:
            try: sock.close()
            except OSError: pass

    def _build_debug_window(self):
        self.debug_window = tk.Toplevel(self.root)
        self.debug_window.title("Debug Console")
        self.debug_window.geometry("550x400")
        self.debug_window.withdraw()
        self.debug_window.protocol("WM_DELETE_WINDOW", self.debug_window.withdraw)

        self.debug_text = scrolledtext.ScrolledText(self.debug_window, state="disabled", wrap="word", font=("Consolas", 9))
        self.debug_text.pack(fill="both", expand=True, padx=5, pady=5)
        
        class StdoutRedirector:
            def __init__(self, eq): self.eq = eq
            def write(self, msg):
                if msg: self.eq.put(("debug", msg))
            def flush(self): pass
            
        sys.stdout = StdoutRedirector(self.event_queue)
        sys.stderr = sys.stdout

    def _toggle_debug(self):
        if self.debug_window.state() == "withdrawn":
            self.debug_window.deiconify()
        else:
            self.debug_window.withdraw()

