        self.header_var = tk.StringVar(value="")
        ttk.Label(header, textvariable=self.header_var, font=("", 10, "bold")).pack(side="left")
        self.leave_btn = ttk.Button(header, text="Leave", command=self.leave_room)
        self.leave_btn.pack(side="right")

        body = ttk.Frame(self.chat_frame, padding=(10, 0, 10, 10))
        body.pack(fill="both", expand=True)
        self.chat_box = scrolledtext.ScrolledText(body, state="disabled", wrap="word")
        self.chat_box.pack(fill="both", expand=True)

        entry_frame = ttk.Frame(self.chat_frame, padding=(10, 0, 10, 10))
        entry_frame.pack(fill="x")
        self.msg_entry = ttk.Entry(entry_frame)
        self.msg_entry.pack(side="left", fill="x", expand=True)
        self.msg_entry.bind("<Return>", lambda event: self.send_message())
        ttk.Button(entry_frame, text="Send", command=self.send_message).pack(side="left", padx=(6, 0))

    def _hide_all(self):
        for frame in (self.home_frame, self.host_frame, self.search_frame, self.join_frame, self.chat_frame, getattr(self, 'tui_frame', None)):
            if frame: frame.pack_forget()

    def _show_home(self):
        self._hide_all()
        self.home_frame.pack(fill="both", expand=True)

    def _show_host(self):
        self._hide_all()
        self.host_frame.pack(fill="both", expand=True)

    def _enter_search(self):
        self._hide_all()
        self.search_frame.pack(fill="both", expand=True)
        self.search_rooms()

    def _show_search(self):
        self._hide_all()
        self.search_frame.pack(fill="both", expand=True)

    def _show_join(self):
        self._hide_all()
        self.join_frame.pack(fill="both", expand=True)

    def _show_chat(self):
        self._hide_all()
        self.chat_frame.pack(fill="both", expand=True)

    def _drain_queue(self):
        try:
            while True:
                kind, payload = self.event_queue.get_nowait()
                if kind == "chat":
                    self.chat_box.configure(state="normal")
                    self.chat_box.insert("end", payload + "\n")
                    self.chat_box.see("end")
                    self.chat_box.configure(state="disabled")
                    if hasattr(self, 'tui_console'):
                        self._append_app_tui_text(payload)
                elif kind == "joined":
                    room, username = payload
                    self.header_var.set(f"Room: {room} | User: {username}")
                    self._show_chat()
                elif kind == "disconnected":
                    if self.connected:
                        self.connected = False
                        messagebox.showinfo("Disconnected", payload)
                        self._show_home()
        except queue.Empty:
            pass
        self.root.after(100, self._drain_queue)

    def search_rooms(self):
        self.search_status_var.set("Searching for rooms...")
        self.rooms_listbox.delete(0, "end")
        threading.Thread(target=self._search_rooms_bg, daemon=True).start()

    def _search_rooms_bg(self):
        rooms = discover_rooms()
        self.last_discovered_rooms = rooms
        self.displayed_rooms = rooms
        for room in rooms:
            self.rooms_listbox.insert("end", room["room"])
        self.search_status_var.set(f"Found {len(rooms)} room(s).")

    def select_room(self):
        selection = self.rooms_listbox.curselection()
        if not selection: return
        self.selected_room = self.displayed_rooms[selection[0]]
        self.join_room_label_var.set(f"Joining: {self.selected_room['room']}")
        self._show_join()

    def start_hosting(self):
        room = self.host_room_entry.get().strip()
        username = self.host_username_entry.get().strip()
        if not room or not username: return
        server = RoomServer(room, self.host_pw_entry.get())
        port = server.start()
        self.room_server = server
        self.is_host = True
        self._connect_and_login("127.0.0.1", port, room, self.host_pw_entry.get(), username)

    def confirm_join(self):
        if not self.selected_room: return
        username = self.username_entry.get().strip()
        if not username: return
        self._connect_and_login(self.selected_room["host"], self.selected_room["port"], self.selected_room["room"], self.pw_entry.get(), username)

    def _connect_and_login(self, host, port, room, password, username):
        try:
            sock = socket.create_connection((host, port), timeout=5)
            sock.recv(1024)
            sock.sendall((room + "\n").encode("utf-8"))
            sock.recv(1024)
            sock.sendall((VERSION + "\n").encode("utf-8"))
            sock.recv(1024)
            sock.sendall((password + "\n").encode("utf-8"))
            sock.recv(1024)
            sock.sendall(b"Guest\n")
            sock.recv(1024)
            sock.sendall((username + "\n").encode("utf-8"))

            welcome = sock.recv(1024).decode("utf-8")
            self.sock = sock
            self.connected = True
            self.event_queue.put(("chat", welcome.strip()))
            self.event_queue.put(("joined", (room, username)))
            threading.Thread(target=self._receive_loop, daemon=True).start()
        except Exception as e:
            messagebox.showerror("Error", f"Failed to connect: {e}")

    def _receive_loop(self):
        try:
            f_in = self.sock.makefile('r', encoding='utf-8', errors='ignore')
            for line in f_in:
                if not self.connected: break
                text = line.strip()
                if text:
                    self.event_queue.put(("chat", text))
        except OSError:
            pass

    def send_message(self):
        if not self.connected or not self.sock: return
        msg = self.msg_entry.get().strip()
        if not msg: return
        try:
            self.sock.sendall((msg + "\n").encode("utf-8"))
        except OSError:
            pass
        self.msg_entry.delete(0, "end")

    def leave_room(self):
        self.connected = False
        if self.sock:
            try: self.sock.sendall(b"/quit\n")
            except OSError: pass
            self.sock.close()
        if self.is_host and self.room_server:
            self.room_server.stop()
            self.room_server = None
        self._show_home()

    def _on_close(self):
        self.leave_room()
        self.root.destroy()


def main():
    root = tk.Tk()
    app = ChatApp(root)
    root.mainloop()


if __name__ == "__main__":
    main()
